<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <Color x:Key="Bg0">#070A10</Color>
    <Color x:Key="Bg1">#0B1020</Color>
    <Color x:Key="Bg2">#0F1730</Color>
    <Color x:Key="Text0">#E8F0FF</Color>
    <Color x:Key="Text1">#9FB0D0</Color>
    <Color x:Key="Accent">#00E5FF</Color>
    <Color x:Key="AccentWarm">#FFD166</Color>

    <SolidColorBrush x:Key="BrushBg0" Color="{StaticResource Bg0}" />
    <SolidColorBrush x:Key="BrushBg1" Color="{StaticResource Bg1}" />
    <SolidColorBrush x:Key="BrushBg2" Color="{StaticResource Bg2}" />
    <SolidColorBrush x:Key="BrushText0" Color="{StaticResource Text0}" />
    <SolidColorBrush x:Key="BrushText1" Color="{StaticResource Text1}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource Accent}" />

    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#00000000" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#00000000" />
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.launcherShell">
    <Setter Property="Background" Value="#DC07101A" />
    <Setter Property="BorderBrush" Value="#3F87B8D8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="BoxShadow" Value="0 18 40 0 #40000000" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource BrushText0}" />
  </Style>

  <Style Selector="TextBlock.launcherEyebrow">
    <Setter Property="Foreground" Value="#A0BFE0FF" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="2" />
  </Style>

  <Style Selector="TextBlock.launcherTitle">
    <Setter Property="Foreground" Value="#F3FAFF" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="TextBlock.launcherHint">
    <Setter Property="Foreground" Value="#B4C5D8" />
  </Style>

  <Style Selector="Border.searchSurface">
    <Setter Property="Background" Value="#101728" />
    <Setter Property="BorderBrush" Value="#2A3A60" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="18,14" />
    <Setter Property="BoxShadow" Value="0 10 24 0 #24000000" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Foreground" Value="{StaticResource BrushText0}" />
    <Setter Property="CaretBrush" Value="{StaticResource BrushAccent}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="SelectionBrush" Value="#557FDFFF" />
  </Style>

  <Style Selector="TextBox.searchBox">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="TextBox.searchBox:focus">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="TextBox /template/ Border#borderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
  </Style>

  <Style Selector="TextBox:focus /template/ Border#borderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
  </Style>

  <Style Selector="TextBox.searchBox /template/ Border#BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
  </Style>

  <Style Selector="TextBox.searchBox:focus /template/ Border#BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
  </Style>

  <Style Selector="TextBox.searchBox /template/ Grid#UnderlineContainer">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="TextBox.searchBox:focus /template/ Grid#UnderlineContainer">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="Border.resultsPanel">
    <Setter Property="Background" Value="#0E1A2B" />
    <Setter Property="BorderBrush" Value="#2A3A60" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="6" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style Selector="ListBoxItem:pointerover">
    <Setter Property="Background" Value="#1E163148" />
  </Style>

  <Style Selector="ListBoxItem:selected">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2200E5FF" Offset="0" />
        <GradientStop Color="#1200E5FF" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="TextBlock.resultSubtitle">
    <Setter Property="Foreground" Value="{StaticResource BrushText1}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBlock.resultTitle">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="22" />
  </Style>

  <Style Selector="TextBlock.resultPrefix">
    <Setter Property="Foreground" Value="#FFD36E" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="#F20A1320" />
    <Setter Property="BorderBrush" Value="#5A87B8D8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6" />
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource BrushText0}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <Style Selector="MenuItem:pointerover">
    <Setter Property="Background" Value="#1E163148" />
  </Style>
</Styles>
